{
  "name": "@dsh-remote/protocol",
  "version": "0.2.0",
  "description": "DSH wire protocol core: JSON envelopes, lenient codec, DTO ports. Pure TS, zero runtime deps.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "@types/node": "^22.0.0"
  }
}
