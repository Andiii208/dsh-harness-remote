{
  "expo": {
    "name": "harness remote",
    "slug": "dsh-remote",
    "scheme": "dshremote",
    "version": "0.3.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7FA",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.dshremote.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "dsh-remote 通过本地网络连接你的 DeepSeek Harness 实例"
      }
    },
    "android": {
      "package": "dev.dshremote.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-background-task",
      "expo-router",
      ["expo-splash-screen", {
        "backgroundColor": "#F7F7FA",
        "resizeMode": "cover",
        "image": "./assets/splash.png"
      }],
      [
        "expo-camera",
        {
          "cameraPermission": "允许 harness remote 使用相机扫描配对二维码"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
