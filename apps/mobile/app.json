{
  "expo": {
    "name": "dsh-remote",
    "slug": "dsh-remote",
    "scheme": "dshremote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0E10",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0E0E10",
      "resizeMode": "contain",
      "image": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.dshremote.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "dsh-remote 通过本地网络连接你的 DeepSeek Harness 实例"
      }
    },
    "android": {
      "package": "dev.dshremote.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E10"
      }
    },
    "plugins": [
      "expo-notifications",
      "expo-background-task",
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
